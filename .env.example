# 로컬 개발: 그대로 두면 프로젝트 루트에 local.db 파일이 생성됩니다.
# Vercel 배포: Turso 데이터베이스의 libsql:// URL과 토큰을 넣어주세요.
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# 아래 시크릿들은 반드시 랜덤한 값으로 바꿔서 .env.local(커밋되지 않음)에 넣으세요.
# 생성 예: openssl rand -hex 32
IP_HASH_SECRET=change-me
CAPTCHA_SECRET=change-me
ADMIN_SESSION_SECRET=change-me

# 관리자 비밀번호: 운영에서는 ADMIN_PASSWORD_HASH를 사용하세요.
# `npm run hash-password -- <비밀번호>` 로 해시를 생성할 수 있습니다.
ADMIN_PASSWORD_HASH=
# 로컬 개발 편의용 평문 비밀번호 (ADMIN_PASSWORD_HASH가 없을 때만 사용됨)
ADMIN_PASSWORD=dev-admin-password

# 제출 간격 제한 (초)
RATE_LIMIT_SECONDS=60
COMMENT_RATE_LIMIT_SECONDS=15
